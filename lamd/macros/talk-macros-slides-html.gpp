\ifndef{talkMacrosSlidesHtml}
\define{talkMacrosSlidesHtml}
\define{\slidesmall{block}}{<small>\block</small>}


\define{\includegooglebook{id}{page}}{\centerdiv{[![](\diagramsDir/books/\id-\page.png)](https://play.google.com/books/reader?id=\id&pg=\page)}}

\define{\includeplotly{filename}{width}{height}}{<section data-background-iframe="\filename\ifdef{DARKBACKGROUND}.dark\endif.html" data-background-interactive></section>}


\define{\speakernotes{text}}{<aside class="notes">
\text
</aside>}

\define{\narration{text}}{<aside class="notes">
\text
</aside>}

\define{\fragment{text}{type}}{<span class="fragment \type">\text</span>}
\define{\fragmentgroup{text}{index}}{<g class="fragment" data-fragment-index="\index">\text</g>}
\define{\fragmentindex{text}{type}{index}}{<span class="fragment \type" data-fragment-index="\index">\text</span>}

\define{\fragmentdiv{contents}{number}{style}}{<div class="fragment" data-fragment-index="\number" style="\style">\contents</div>}


\defeval{\figure{contents}{captionContents}{label}}{<div class="figure">
<div class="figure-frame" id="\concat{\label}{-figure}">
\contents
</div>
</div>
<aside class="notes">\captionContents</aside>}

\define{\startanimation{group}{start}{finish}{name}}{<div id="animation-\group" class="lamd-animation" role="region" aria-label="\name" data-animation-group="\group"><noscript><style>#animation-\group .animation-controls{display:none}#animation-\group .\group~.\group{display:none}</style></noscript><div class="animation-controls">
\smalltext{\name} <input id="range-\group" type="range" min="\start" max="\finish" value="\start" aria-label="Frame slider for \name" aria-valuemin="\start" aria-valuemax="\finish" aria-valuenow="\start" onchange="typeof lamdSetDivs==='function'&&lamdSetDivs('\group')" oninput="typeof lamdSetDivs==='function'&&lamdSetDivs('\group')">
<button type="button" onclick="typeof lamdPlusDivs==='function'&&lamdPlusDivs(-1,'\group');" aria-label="Previous frame">❮</button>
<button type="button" onclick="typeof lamdPlusDivs==='function'&&lamdPlusDivs(1,'\group');" aria-label="Next frame">❯</button>
</div><script>
document.addEventListener('DOMContentLoaded',function(){
try{
if(typeof showDivs==='function'){showDivs(1,'\group');}
else{
console.warn('[lamd] figure-animate.js not loaded; animation "'+'\group'+'" degraded to static first frame.');
var c=document.getElementById('animation-\group');
if(c){var ctrl=c.querySelector('.animation-controls');if(ctrl){ctrl.style.display='none';}}
var f=document.getElementsByClassName('\group');
for(var i=1;i<f.length;i++){f[i].style.display='none';}
if(f.length>0){f[0].style.display='block';}
}
}catch(e){console.warn('[lamd] Animation "'+'\group'+'" failed to initialize:',e);}
});
</script>
}


\define{\newframe{contents}{name}{style}}{<div style="text-align:center;\style" class="\name" role="img" aria-label="\name" data-animation-frame="\name">\contents</div>}

\define{\endanimation}{</div>}

\endif