\ifndef{talkMacrosEdit}
\define{talkMacrosEdit}


\ifdef{DRAFT}
\define{\editme}{\alignright{\href{file://\talksDir\file}{\file}}}
\else
\define{\editHref}{\ifdef{localEditUrl}\ifeq{\file}{\gppTempFile}\localEditUrl\else\githubBaseUrl\file\endif\else\githubBaseUrl\file\endif}
\define{\editme}{\define{editText}{\alignright{\span{[}{editsection-bracket}\span{\hrefOther{\editHref}{edit}{onclick="ga('send', 'event', 'Edit Page', 'Edit', '\editHref', 13);"}}{editsection}\span{]}{editsection-bracket}}}}
\endif

\endif
